          "SP": -4,
          "FN": 0,
          "RB": 0
        },
        "next": "26-R"
      },
      "autoNext": null,
      "note": null
    },
    {
      "sequence": 26,
      "id": "26-L",
      "tag": null,
      "text": "周秀兰，中年丧女，在医院做了二十年保洁。\n她好心提醒病人注意出行，也祭奠过那位老兵。\n第二组审判的王淑云，是她唯一的朋友。",
      "left": {
        "label": "厄运专找苦命人",
        "effects": {
          "QI": 0,
          "SP": 4,
          "FN": 0,
          "RB": 0
        },
        "next": "26-R"
      },
      "right": {
        "label": "她是不是人间版的死神",
        "effects": {
          "QI": 0,
          "SP": -4,
          "FN": 0,
          "RB": 0
        },
        "next": "26-R"
      },
      "autoNext": "26-R",
      "note": "下一个自动跳转 26-R（双卡阅读后收束到 28）"
    },
    {
      "sequence": 27,
      "id": "26-R",
      "tag": null,
      "text": "陈晋原，行政副院长，\n他再次否决了电路翻修计划。\n确切地说，有人用电力公司的评估报告把他的申请打回来。在没发生事故之前，让医院保持现状。",
      "left": {
        "label": "照片上的数字好熟悉",
        "effects": {
          "QI": 0,
          "SP": 0,
          "FN": 4,
          "RB": 0
        },
        "next": "26-L"
      },
      "right": {
        "label": "什么叫再次？",
        "effects": {
          "QI": 0,
          "SP": 0,
          "FN": -4,
          "RB": 0
        },
        "next": "26-L"
      },
      "autoNext": "26-L",
      "note": "下一个自动跳转 26-L（双卡阅读后收束到 28）"
    },
    {
      "sequence": 28,
      "id": "28",
      "tag": null,
      "text": "陈晋原也曾是我入职测试的题目。\n我们是同学。我知道，他是个负责人的好人。\n现在他再次成为题目，也许是对我的惩罚。",
      "left": {
