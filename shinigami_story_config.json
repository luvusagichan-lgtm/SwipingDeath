          "FN": 0,
          "RB": -4
        },
        "next": "24"
      },
      "autoNext": "24",
      "note": "这张卡结束后跳转 24"
    },
    {
      "sequence": 24,
      "id": "24",
      "tag": null,
      "text": "周秀兰在楼梯间捡到了王淑云的工牌。\n她擦了擦上面的灰，放进了自己的口袋。",
      "left": {
        "label": "她还好吗",
        "effects": {
          "QI": 0,
          "SP": 4,
          "FN": 0,
          "RB": 0
        },
        "next": "25"
      },
      "right": {
        "label": "周秀兰有点奇怪",
        "effects": {
          "QI": 0,
          "SP": -4,
          "FN": 0,
          "RB": 0
        },
        "next": "25"
      },
      "autoNext": null,
      "note": null
    },
    {
      "sequence": 25,
      "id": "25",
      "tag": null,
      "text": "恭喜你，走到最后。\n现在有两个人的心脏即将同时停搏。\n其中一个人……你见过。",
      "left": {
        "label": "等等，不会是——！？",
        "effects": {
          "QI": 0,
          "SP": 8,
          "FN": 0,
          "RB": 0
        },
        "next": "26-L"
      },
      "right": {
